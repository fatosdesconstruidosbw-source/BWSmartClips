{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BWSmartClips",
  "version": "1.0.0",
  "identifier": "com.bwsmartclips.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BWSmartClips",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Video",
    "shortDescription": "Cortes virais com IA, estilo Opus Clip",
    "longDescription": "Transforma vídeos longos em cortes verticais com legendas animadas e rastreamento de rosto, escolhidos por IA.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
